# Copy to .env.development.local for local dev (or run `vercel env pull`).
# In production, set these in the Vercel project settings.

# Public (bundled into the client)
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000

# Server only (used by /api functions; never prefix with VITE_)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000
