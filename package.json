{
	"name": "jammming",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:vercel": "vercel dev --listen 127.0.0.1:3000",
		"env:pull": "vercel env pull .env.development.local --environment=development --yes",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:ui": "vitest --ui",
		"check": "biome check . && vitest run && vite build",
		"deploy": "vercel --prod"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@tanstack/react-query": "^5.104.1",
		"cookie": "^1.1.1",
		"lucide-react": "^0.562.0",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"sonner": "^2.0.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.8",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"@vitest/ui": "^4.0.17",
		"babel-plugin-react-compiler": "^1.0.0",
		"dotenv": "^17.2.3",
		"jsdom": "^27.4.0",
		"vite": "^7.3.1",
		"vitest": "^4.0.17"
	},
	"engines": {
		"node": ">=20"
	}
}
